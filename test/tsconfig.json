{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // The Android build scripts are imported by `test/android/`, and the script
    // family imports its siblings with explicit `.ts` extensions so `tsx` runs
    // them without a build step.
    "allowImportingTsExtensions": true,
    // `vite/client` is in the list because the SPA's source is part of this
    // program: the app reads `import.meta.env.PROD` to decide whether to
    // register the service worker, and the SPA's own tsconfig declares the
    // same types.
    "types": ["node", "vite/client"],
    // The SPA's sandbox type stub applies here too: the test program compiles
    // the same widget component and loader sources.
    "paths": {
      "@telegram/widget-sandbox/host/widget-host": ["../apps/web/src/widget-sandbox-api"],
      "@telegram/widget-sandbox/host/renderer": ["../apps/web/src/widget-sandbox-api"],
      "@telegram/widget-sandbox/host/shadow-renderer": ["../apps/web/src/widget-sandbox-api"]
    }
  },
  // `worker-configuration.d.ts` is included because the tests import the API
  // package, whose source references generated globals like `DurableObjectState`.
  // `packages/backend-runtime/src/env.d.ts` adds the secret-backed `CloudflareEnv` members (the
  // generated file cannot know about secrets); ambient files are not pulled in
  // by importing worker sources, so the test project lists it explicitly.
  "include": [
    "../worker-configuration.d.ts",
    "../packages/backend-runtime/src/env.d.ts",
    // The SPA's ambient module declaration for `opus-recorder`: the test
    // program compiles the recorder's source, and ambient files are not pulled
    // in by importing a module that uses them.
    "../apps/web/src/opus-recorder.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
