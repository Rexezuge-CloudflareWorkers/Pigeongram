# Prettier ignores `node_modules` by default but does NOT read `.gitignore`, so
# every gitignored build artifact has to be named here. Without these entries a
# `format:check` run after a build walks generated output — `worker-configuration.d.ts`
# alone is 600 KB of generated types.
dist/
coverage/
node_modules/
.wrangler/
worker-configuration.d.ts
wrangler.jsonc

# Rendered by the Android workflow from a template; formatting generated Gradle
# files is not a review anyone should do.
android/build/

# A keystore should never be in the checkout, but if one is, Prettier must not
# try to parse it (or print it).
*.jks
*.jks.*
*.keystore
*.keystore.*
*.p12
*.pfx

# Machine-generated. Reformatting the lockfile produces a diff no human reads and
# no reviewer should approve by reflex.
pnpm-lock.yaml

# Agent session transcripts kept beside the worklog for continuity. They are
# machine-generated logs, not documents anyone edits.
docs/*session-*.md
