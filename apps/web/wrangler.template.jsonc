{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Materialized to `./wrangler.jsonc` at the repo root before deploy (the CD
  // workflow copies it there), which is why `pages_build_output_dir` is
  // root-relative (`apps/web/dist/`, not `dist/`). Pages Functions live at repo-root
  // `functions/` for the same reason: `/api/*` is the public plane and `/user/*`
  // is the Access-gated user API.
  "name": "telegram-web-client-web",
  "compatibility_date": "2025-12-31",
  "pages_build_output_dir": "apps/web/dist/",
  // The Pages Functions (`functions/api/*`, `functions/user/*`) proxy to the
  // worker over this service binding; the worker is never publicly routable.
  "services": [{ "binding": "API_WORKER", "service": "telegram-web-client" }],
}
