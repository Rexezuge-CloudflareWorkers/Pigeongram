{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // The generated `worker-configuration.d.ts` supplies the Workers runtime
  // globals (`DurableObjectState`, `DurableObjectNamespace`, …) and the
  // `CloudflareEnv` interface. It is produced by `pnpm run typegen` on
  // postinstall and is never committed.
  "include": ["../worker-configuration.d.ts", "src/**/*.ts"]
}
