{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Materialized to `./wrangler.jsonc` at the repo root before dev/deploy (see
  // scripts/prepare-wrangler-config.ts), which is why `main` and every other
  // path here is root-relative. Do not move it under worker/.
  "name": "telegram-web-client",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-12-31",
  "placement": { "mode": "off" },
  // The worker is API-only and is reached exclusively through the Pages
  // project's `/api/*` proxy (declared by the `API_WORKER` service binding in
  // pages/wrangler.template.jsonc) — never from the public internet directly.
  "workers_dev": false,
  // Workers Logs: per-invocation CPU time is what the session-engine spike is
  // measured against, so the engine (and its Durable Object) must be logged.
  "observability": { "enabled": true },
  // One DO class, one binding. The `v1` SQLite migration must be present on the
  // very first deploy; renaming the class or the binding later requires a new
  // migration tag, so only change them deliberately.
  "durable_objects": {
    "bindings": [{ "name": "SESSION_ENGINE", "class_name": "SessionEngine" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionEngine"] }],
  "vars": {
    "ENVIRONMENT": "production",
    // Cadence of the session engine's wake alarm, in seconds. The Free-tier
    // budget assumes 300 (12 wakes/hour); raise it to trade presence for cost.
    "WAKE_INTERVAL_SECONDS": "300",
  },
}
