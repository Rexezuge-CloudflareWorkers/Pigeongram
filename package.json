{
  "name": "@telegram-web-client/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run checks:fast && pnpm run test:coverage",
    "checks:fast": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:god-files",
    "prettier": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:scripts && pnpm run typecheck:functions",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "check:god-files": "tsx scripts/check-god-files.ts --fail-on-hard",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint --fix --quiet .",
    "typegen": "wrangler types --config ./worker/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@rexezuge/tooling": "1.9.2",
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.2.2"
}
