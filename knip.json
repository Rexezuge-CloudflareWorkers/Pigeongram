{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["bubblewrap", "keytool", "jarsigner"],
  "workspaces": {
    "apps/web": {
      "entry": ["build/**/*.ts"]
    },
    "test": {
      "entry": ["**/*.test.ts", "**/*.test.tsx"],
      "ignoreDependencies": ["lottie-web"]
    }
  },
  "ignore": ["scripts/lib/**", "scripts/wrangler-config/**"]
}
