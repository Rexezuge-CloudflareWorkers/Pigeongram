{
  "name": "@pigeongram/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm run checks:fast && pnpm run test:coverage",
    "checks:fast": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:god-files && pnpm run check:dead-code && pnpm run validate:locales",
    "prettier": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:scripts && pnpm run typecheck:functions && pnpm run typecheck:web-build",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "typecheck:web-build": "tsc -p apps/web/build/tsconfig.json --noEmit && tsc -p apps/web/sw/tsconfig.json --noEmit",
    "check:god-files": "tsx scripts/check-god-files.ts --fail-on-hard",
    "check:dead-code": "knip",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint --fix --quiet .",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv",
    "validate:locales": "tsx scripts/validate-locales.ts",
    "generate:vapid": "tsx scripts/generate-vapid-keys.ts"
  },
  "devDependencies": {
    "@rexezuge/tooling": "1.9.4",
    "@types/node": "26.6.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.14.0",
    "jsdom": "^31.0.1",
    "jsonc-parser": "3.3.1",
    "knip": "6.48.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  },
  "packageManager": "pnpm@11.2.2"
}
