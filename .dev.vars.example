# Local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill in:
#   cp .dev.vars.example .dev.vars
#
# Production values are Worker secrets, set once per environment:
#   pnpm exec wrangler secret put TELEGRAM_API_ID
#   pnpm exec wrangler secret put TELEGRAM_API_HASH
#
# The production Access verifier is configured with the `TEAM_DOMAIN` and
# `POLICY_AUD` vars, not with a secret.

# api_id / api_hash from https://my.telegram.org → "API development tools".
# The id is read as a string and parsed as a number by the engine.
TELEGRAM_API_ID="1234567"
TELEGRAM_API_HASH="0123456789abcdef0123456789abcdef"

# Local development does not pass through Cloudflare Access, so the worker's
# JWT check would reject every request. The bypass is honored only while
# ENVIRONMENT is not "production"; in a real deployment it fails closed.
ENVIRONMENT="development"
ACCESS_DEV_BYPASS="true"
